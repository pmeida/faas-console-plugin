FROM registry.access.redhat.com/ubi9/go-toolset:1.27.3-1794518352@sha256:4053e919374d739ee6b0007e412d89256b0bd065e0bc690c2b3905bbaab6500e

USER root

# Switch to Node.js 24 (base image ships Node 22; webpack-cli 7 needs
# native TS type stripping for .mts configs, unflagged since Node 23.6)
RUN dnf module reset nodejs -y \
    && dnf module enable nodejs:24 -y \
    && dnf module install nodejs:24/common -y \
    && dnf clean all

# Corepack + Yarn 4
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_HOME=/tmp/corepack
RUN npm i -g corepack && corepack enable

# ko (checksum-verified download)
ARG KO_VERSION=0.19.1
ARG KO_SHA256_x86_64=635ac6ea3fd376c935fee597fbb29ab2c2449f49ef1655085fe3aa9c25fed7a5
ARG KO_SHA256_arm64=4099b2d1170d3b8a70e049237462efc2dd14d5fa30e9d2e5e108fb4f778cdd3f
RUN ARCH=$(uname -m | sed 's/aarch64/arm64/') \
    && eval "CHECKSUM=\${KO_SHA256_${ARCH}}" \
    && curl -fsSL "https://github.com/ko-build/ko/releases/download/v${KO_VERSION}/ko_${KO_VERSION}_Linux_${ARCH}.tar.gz" -o /tmp/ko.tar.gz \
    && echo "${CHECKSUM}  /tmp/ko.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/ko.tar.gz -C /usr/local/bin ko \
    && rm /tmp/ko.tar.gz

# Playwright system dependencies (Chromium)
RUN dnf install -y \
    nss atk at-spi2-atk cups-libs libdrm libXcomposite libXdamage libXrandr \
    mesa-libgbm pango alsa-lib libxkbcommon \
    && dnf clean all
